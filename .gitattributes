# Unity attribute macros must be defined at the repository root.
# Project asset rules remain in BartenderSimVR/.gitattributes.
[attr]lfs        filter=lfs diff=lfs merge=lfs -text
[attr]unity-json eol=lf linguist-language=json
[attr]unity-yaml merge=unityyamlmerge eol=lf linguist-language=yaml

# Keep repository documentation and scripts readable across platforms.
*.md text eol=lf
*.ps1 text eol=lf
